    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.1.1</Version>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OSCQueryExplorer.Core\OSCQueryExplorer.Core.csproj" />
    <ProjectReference Include="..\OSCQueryExplorer.Protocol\OSCQueryExplorer.Protocol.csproj" />
  </ItemGroup>

</Project>
