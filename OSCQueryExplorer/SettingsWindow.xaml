<ui:FluentWindow x:Class="OSCQueryExplorer.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="設定" Width="560" Height="570" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="設定" FontSize="25" FontWeight="SemiBold" />
      <TextBlock Text="表示、接続、更新確認の動作を変更します。" Margin="0,5,0,20"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="テーマ" FontWeight="SemiBold" />
        <TextBlock Text="変更は保存時に反映されます" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <ComboBox x:Name="ThemeBox" Grid.Column="1" SelectedValuePath="Tag">
        <ComboBoxItem Content="システム設定" Tag="System" />
        <ComboBoxItem Content="ライト" Tag="Light" />
        <ComboBoxItem Content="ダーク" Tag="Dark" />
      </ComboBox>
    </Grid>

    <Grid Grid.Row="2" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="ログ文字サイズ" FontWeight="SemiBold" />
        <TextBlock Text="9～30 pt" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <TextBox x:Name="LogFontSizeBox" Grid.Column="1" />
    </Grid>

    <Grid Grid.Row="3" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="ツリー更新間隔" FontWeight="SemiBold" />
        <TextBlock Text="1～300 秒" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <TextBox x:Name="PollingIntervalBox" Grid.Column="1" />
    </Grid>

    <StackPanel Grid.Row="4" Margin="0,4,0,16">
      <CheckBox x:Name="PublishToLanBox" Content="ローカルOSCQuery ServerとOSC受信をLANへ公開する" />
      <TextBlock Text="有効化は次回接続時に反映されます。信頼できるネットワークでのみ使用してください。"
                 Margin="24,5,0,0" FontSize="10" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <CheckBox x:Name="AutomaticUpdateCheckBox" Content="起動時に更新を確認する（24時間に1回まで）" Margin="0,15,0,0" />
    </StackPanel>

    <Border Grid.Row="5" Padding="14" CornerRadius="9" VerticalAlignment="Top"
            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="アプリの更新" FontWeight="SemiBold" />
          <TextBlock Text="GitHub Releasesで新しいバージョンを確認します。" Margin="0,3,10,0" FontSize="10"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ui:Button x:Name="CheckUpdatesButton" Grid.Column="1" Content="今すぐ確認" Click="CheckUpdates_Click" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <ui:Button Content="キャンセル" IsCancel="True" Margin="4" />
      <ui:Button Content="保存" Appearance="Primary" Click="Save_Click" Margin="4" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
